# ResumeIQ Configuration
PROJECT_NAME="ResumeIQ — AI Resume Parser & ATS Optimizer"
DATABASE_URL=sqlite:///./resumeiq.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/resumeiq

SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Configuration
# Set AI_PROVIDER=openai to use OpenAI API, or leave as 'fallback' for intelligent built-in NLP engine
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size in MB
MAX_UPLOAD_SIZE_MB=10
